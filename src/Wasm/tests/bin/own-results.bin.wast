(module definition binary
  "\00\61\73\6d\01\00\00\00\01\99\80\80\80\00\04\60"
  "\00\02\7f\7f\60\00\03\7f\7f\7f\60\01\7f\02\7f\7f"
  "\60\02\7f\7f\02\7f\7f\03\86\80\80\80\00\05\00\01"
  "\03\00\02\07\a3\80\80\80\00\05\03\74\77\6f\00\00"
  "\05\74\68\72\65\65\00\01\04\73\77\61\70\00\02\02"
  "\62\72\00\03\05\62\72\5f\69\66\00\04\0a\c2\80\80"
  "\80\00\05\86\80\80\80\00\00\41\01\41\02\0b\88\80"
  "\80\80\00\00\41\01\41\02\41\03\0b\86\80\80\80\00"
  "\00\20\01\20\00\0b\8a\80\80\80\00\00\41\09\41\01"
  "\41\02\0c\00\0b\8a\80\80\80\00\00\41\01\41\02\20"
  "\00\0d\00\0b"
)
(module instance)
(assert_return (invoke "two") (i32.const 0x1) (i32.const 0x2))
(assert_return (invoke "three") (i32.const 0x1) (i32.const 0x2) (i32.const 0x3))
(assert_return
  (invoke "swap" (i32.const 0x1) (i32.const 0x2))
  (i32.const 0x2)
  (i32.const 0x1)
)
(assert_return (invoke "br") (i32.const 0x1) (i32.const 0x2))
(assert_return (invoke "br_if" (i32.const 0x0)) (i32.const 0x1) (i32.const 0x2))
(assert_return (invoke "br_if" (i32.const 0x1)) (i32.const 0x1) (i32.const 0x2))
(assert_invalid
  (module binary
    "\00\61\73\6d\01\00\00\00\01\86\80\80\80\00\01\60"
    "\00\02\7f\7f\03\82\80\80\80\00\01\00\0a\8a\80\80"
    "\80\00\01\84\80\80\80\00\00\41\01\0b"
  )
  "type mismatch"
)
(assert_invalid
  (module binary
    "\00\61\73\6d\01\00\00\00\01\86\80\80\80\00\01\60"
    "\00\02\7f\7f\03\82\80\80\80\00\01\00\0a\8e\80\80"
    "\80\00\01\88\80\80\80\00\00\41\01\41\02\41\03\0b"
  )
  "type mismatch"
)
